#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <sys/utsname.h>
#include <sys/statvfs.h>
#include <signal.h>
#include <string.h>
#include <fcntl.h>
#include <errno.h>

/* ---------------- SIGNAL HANDLER ---------------- */

volatile sig_atomic_t running = 1;

void handle_sigint(int sig)
{
    printf("\n[Signal Handler] SIGINT received.\n");
    printf("[Monitor] Stopping monitoring...\n");

    running = 0;
}

/* ---------------- SYSTEM INFORMATION ---------------- */

void show_system_info()
{
    struct utsname system_info;
    char hostname[256];

    printf("\n====================================\n");
    printf("       SYSTEM INFORMATION\n");
    printf("====================================\n");

    /* uname() -> system call */
    if (uname(&system_info) == 0)
    {
        printf("Operating System : %s\n", system_info.sysname);
        printf("Kernel Release   : %s\n", system_info.release);
        printf("Machine          : %s\n", system_info.machine);
    }

    /* gethostname() -> system call */
    if (gethostname(hostname, sizeof(hostname)) == 0)
    {
        printf("Hostname         : %s\n", hostname);
    }

    printf("Current PID      : %d\n", getpid());
    printf("Parent PID       : %d\n", getppid());
}

/* ---------------- MEMORY INFORMATION ---------------- */

void show_memory()
{
    FILE *file;
    char line[256];

    printf("\n====================================\n");
    printf("          MEMORY INFORMATION\n");
    printf("====================================\n");

    /*
     * /proc/meminfo is provided by the Linux kernel.
     * We read it from user space.
     */

    file = fopen("/proc/meminfo", "r");

    if (file == NULL)
    {
        perror("Unable to open /proc/meminfo");
        return;
    }

    int count = 0;

    while (fgets(line, sizeof(line), file) != NULL && count < 5)
    {
        printf("%s", line);
        count++;
    }

    fclose(file);
}

